{
  "schema": 1,
  "id": "postgres",
  "name": "PostgreSQL",
  "summary": "The PostgreSQL relational database, official image.",
  "category": "database",
  "tags": ["sql", "database", "postgresql"],
  "icon": "postgresql",
  "homepage": "https://www.postgresql.org/",
  "docs": "https://hub.docker.com/_/postgres",
  "image": {
    "repository": "postgres",
    "versions": [
      { "tag": "17-alpine", "label": "17 (alpine)", "recommended": true },
      { "tag": "16-alpine", "label": "16 (alpine)" },
      { "tag": "15-alpine", "label": "15 (alpine)" }
    ]
  },
  "variables": [
    { "key": "POSTGRES_USER", "label": "Superuser", "kind": "string", "default": "postgres", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$" },
    { "key": "POSTGRES_PASSWORD", "label": "Superuser password", "kind": "secret", "required": true, "generate": "password", "min": 12 },
    { "key": "POSTGRES_DB", "label": "Initial database", "kind": "string", "default": "app", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$" }
  ],
  "env": { "POSTGRES_USER": "${POSTGRES_USER}", "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}", "POSTGRES_DB": "${POSTGRES_DB}" },
  "ports": [{ "container": 5432, "host": null, "label": "PostgreSQL" }],
  "volumes": [{ "target": "/var/lib/postgresql/data", "label": "Data", "default": "volume:${name}-data" }],
  "network": { "default": "dedicated", "aliases": ["postgres", "db"] },
  "healthcheck": { "test": ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"], "intervalMs": 10000, "timeoutMs": 5000, "retries": 5, "startPeriodMs": 20000 },
  "monitoring": { "type": "docker" },
  "autoheal": { "default": false },
  "updates": { "default": false },
  "notes": ["Major-version upgrades need a dump/restore; the catalog does not perform them, which is why update tracking is off by default."]
}
