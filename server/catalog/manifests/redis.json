{
  "schema": 1,
  "id": "redis",
  "name": "Redis",
  "summary": "In-memory key/value store, official image.",
  "category": "database",
  "tags": ["cache", "key-value", "queue"],
  "icon": "redis",
  "homepage": "https://redis.io/",
  "image": {
    "repository": "redis",
    "versions": [
      { "tag": "7-alpine", "label": "7 (alpine)", "recommended": true },
      { "tag": "6-alpine", "label": "6 (alpine)" }
    ]
  },
  "variables": [
    { "key": "MAXMEMORY", "label": "Max memory", "kind": "string", "default": "256mb", "pattern": "^[0-9]{1,6}(mb|gb)$" }
  ],
  "env": {},
  "container": { "command": ["redis-server", "--maxmemory", "${MAXMEMORY}", "--maxmemory-policy", "allkeys-lru", "--save", "60", "1"] },
  "ports": [{ "container": 6379, "host": null, "label": "Redis" }],
  "volumes": [{ "target": "/data", "label": "Data", "default": "volume:${name}-data" }],
  "network": { "default": "dedicated", "aliases": ["redis", "cache"] },
  "healthcheck": { "test": ["CMD", "redis-cli", "ping"], "intervalMs": 10000, "timeoutMs": 3000, "retries": 5, "startPeriodMs": 5000 },
  "monitoring": { "type": "docker" },
  "autoheal": { "default": true },
  "updates": { "default": true }
}
