# OpusHub environment file — discovery order (first hit wins; real env always beats files):
#   1. $OPUSHUB_ENV_FILE (path to any file)
#   2. <config dir>/.env        ← recommended location, next to services.yaml
#   3. ./config/.env            (this file, in a plain checkout)
#   4. ./.env                   (repo root)
#   5. $HOMEPAGE_DIR/.env       (migration from a Homepage install)
#   6. /app/config/.env         (container convention)
#
# Only server-side values belong here. Nothing from this file is ever sent to the browser
# except the *names* of files found, visible at GET /api/health.

# Network
OPUSHUB_PORT=3000
OPUSHUB_HOST=0.0.0.0

# Optional path overrides
# OPUSHUB_CONFIG_DIR=/etc/opushub
# OPUSHUB_DATA_DIR=/var/lib/opushub

# Infrastructure access (all optional; providers report "unavailable" without them)
# OPUSHUB_DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_HOST=unix:///run/user/1000/docker.sock

# How OpusHub reaches YOUR containers from a browser.
#
# URLs are read from the containers themselves: Traefik labels first, then the host port a
# container actually published. Published-port URLs need one more thing — the address browsers use
# for this machine — and OpusHub will not invent it. It tries, in order: this setting,
# Settings → System (written to config/settings.yaml), the address the container binds, then a
# site-local interface address. If none of those answer, the service is listed with no URL.
#
# Set it only if detection is wrong for your network (e.g. OpusHub runs in a container on a host
# whose interfaces say something else). Bare host or host:port, no scheme needed.
# OPUSHUB_HOST_ADDRESS=192.168.1.20
#
# If your Traefik entrypoint is not on 80/443, prefer Settings → System → Proxy entrypoint ports
# (or config/settings.yaml → infrastructure.entrypointPorts); it is presentation config, not a secret.

# Files — the read-only file manager (Phase 11A)
#
# OpusHub reads only directories you name here, comma-separated, absolute. Nothing else is
# reachable: the whole filesystem is never a root, `/` is refused outright, and a path that is not a
# readable directory is refused with a reason (shown on the Files page under "Roots"). Symlinks are
# resolved before the check, so a root cannot be a link out of the permitted tree.
#
#   OPUSHUB_FILES_ROOTS=/tank/media,/opt/stacks
#
# In a container these paths must also be mounted (see docker-compose.yml) — a root the container
# cannot see is refused, not invented.
#
# Reading is still gated by role: an administrator may read, search and download; an operator may
# read and search; a viewer may not read files at all. Files whose names match credentials, keys or
# OpusHub's own state are refused wherever they live, and a root you mark sensitive (a log directory,
# say) needs files.read_sensitive as well.
#
# Set this to switch the whole feature off — no root is exposed and no /api/files route answers:
#   OPUSHUB_FILES_DISABLED=1
#
# There is no setting that makes OpusHub write, delete, rename, upload, chmod or chown a file, and
# none that gives it a shell or sudo. This phase has no such code path to enable.

# Note: news feeds, weather location and market symbols are configuration, not secrets —
# they live in config/settings.yaml, not here.
